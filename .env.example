# Copy to .env if you like, then `set -a; source .env; set +a`. Never commit .env.
JOBSEARCH_API_KEY=choose-a-long-random-key
# Optional: use your own adverts (see README, "Use your own job data")
# JOBSEARCH_DATA=data/my_jobs.json
# Optional LLM mode. Any OpenAI-compatible endpoint. Example: local Ollama (free)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=<model you have pulled>
# LLM_API_KEY=
